# Public URL of the dashboard. Must match the browser origin (scheme + host + port).
APP_URL=http://localhost:3000

# Auth.js secret. Generate a strong random value before enabling authentication.
AUTH_SECRET=CHANGE_ME_WITH_AT_LEAST_32_CHARACTERS
AUTH_SESSION_MAX_AGE_SECONDS=86400

# Dedicated AES-256-GCM key for integration secrets. Must be base64 of exactly 32 bytes.
# Generate locally and never commit the result:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Leave empty to start without secret operations (setSecret/test with secrets fail closed).
SECRET_ENCRYPTION_KEY=

# Phase 2 database settings. Local default is SQLite. Production Compose uses PostgreSQL.
DB_DRIVER=sqlite
DATABASE_URL=./appdata/dashboard.sqlite

# Optional override for Phase 14 pre-restore backup files (default: ./appdata/backups).
# BACKUP_DIR=./appdata/backups

# Safe build/runtime identifier used by /health responses. Never a secret.
# APP_VERSION=1.3.0

# Production / advanced mode.
# REDIS_URL=redis://localhost:6379
# WORKER_URL=http://127.0.0.1:3001
# REALTIME_URL=http://127.0.0.1:3002
# WORKER_HOST=0.0.0.0
# WORKER_PORT=3001
# REALTIME_HOST=0.0.0.0
# REALTIME_PORT=3002

LOG_LEVEL=info
INTEGRATION_DEFAULT_TIMEOUT_MS=8000

# Compose production secrets live in .env.production.example. Copy that file for Docker.
