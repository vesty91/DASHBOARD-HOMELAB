# Public URL of the dashboard.
APP_URL=http://localhost:3000

# Auth.js secret. Generate a strong random value before enabling authentication.
AUTH_SECRET=CHANGE_ME_WITH_AT_LEAST_32_CHARACTERS
AUTH_SESSION_MAX_AGE_SECONDS=86400

# Dedicated AES-256-GCM key for integration secrets. Must be base64 of exactly 32 bytes.
# Generate locally and never commit the result:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Leave empty to start without secret operations (setSecret/test with secrets fail closed).
SECRET_ENCRYPTION_KEY=

# Phase 2 database settings.
DB_DRIVER=sqlite
DATABASE_URL=./appdata/dashboard.sqlite

# Production / advanced mode.
# REDIS_URL=redis://localhost:6379

LOG_LEVEL=info
INTEGRATION_DEFAULT_TIMEOUT_MS=8000
