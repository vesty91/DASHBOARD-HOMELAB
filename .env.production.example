# Copy to `.env` next to compose.yaml. Never commit a filled copy.
# Generate secrets locally:
#   node -e "console.log('AUTH_SECRET=' + require('crypto').randomBytes(32).toString('hex'))"
#   node -e "console.log('SECRET_ENCRYPTION_KEY=' + require('crypto').randomBytes(32).toString('base64'))"
#   node -e "console.log('POSTGRES_PASSWORD=' + require('crypto').randomBytes(18).toString('base64url'))"

# Public origin seen by browsers. Must match reverse-proxy HTTPS origin.
APP_URL=https://dashboard.example.com

AUTH_SECRET=
SECRET_ENCRYPTION_KEY=

# Compose interpolates DATABASE_URL from these values. Use URL-safe passwords
# (no `@`, `:`, `/`, or `#`) or URL-encode the password yourself.
POSTGRES_USER=dashboard
POSTGRES_DB=dashboard
POSTGRES_PASSWORD=

# Optional image tag / GHCR prefix when pulling published images instead of building.
APP_VERSION=1.0.1
# DASHBOARD_IMAGE_PREFIX=ghcr.io/vesty91/dashboard-homelab

# Published only on loopback. Put Caddy/Nginx in front for HTTPS.
WEB_PORT=3000

LOG_LEVEL=info

# Redis has no password in the default Compose stack and is not published.
# If you add Redis AUTH, set REDIS_URL at runtime only (never bake it into the image).
# REDIS_URL=redis://:password@redis:6379

# OIDC is configured in the admin UI after onboarding. No OIDC client secret is
# required in this file when OIDC stays disabled.

# Phase 14 pre-restore files inside the web container (named volume `appdata`).
# BACKUP_DIR=/appdata/backups
