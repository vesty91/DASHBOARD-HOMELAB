{
  "name": "homelab-dashboard",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.23.0"
  },
  "scripts": {
    "dev": "turbo dev --filter=@dashboard/web",
    "build": "turbo build",
    "lint": "node scripts/check-architecture-boundaries.mjs && node scripts/check-production-compose.mjs && turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "pnpm --filter @dashboard/web test:e2e",
    "test:db:postgres": "pnpm --filter @dashboard/db test:postgres",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm build",
    "bundle:runtime": "node scripts/bundle-runtime.mjs",
    "test:production": "node scripts/production-smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "turbo": "2.10.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "esbuild": "0.25.11"
  }
}
